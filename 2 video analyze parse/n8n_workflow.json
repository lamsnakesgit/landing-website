{
    "name": "Watermark Remover Bot",
    "nodes": [
        {
            "parameters": {
                "updates": [
                    "message"
                ],
                "additionalFields": {}
            },
            "id": "7ec5a2e1-4b1a-4c2d-8e9f-6a5b4c3d2e1f",
            "name": "Telegram Trigger",
            "type": "n8n-nodes-base.telegramTrigger",
            "typeVersion": 1,
            "position": [
                250,
                300
            ],
            "credentials": {
                "telegramApi": {
                    "id": "YOUR_CREDENTIAL_ID",
                    "name": "Telegram Bot"
                }
            }
        },
        {
            "parameters": {
                "command": "python3 /path/to/project/src/remover.py {{ $json[\"message\"][\"text\"] }}"
            },
            "id": "a1b2c3d4-e5f6-4a5b-8c9d-0e1f2a3b4c5d",
            "name": "Execute Remover",
            "type": "n8n-nodes-base.executeCommand",
            "typeVersion": 1,
            "position": [
                500,
                300
            ]
        },
        {
            "parameters": {
                "chatId": "={{ $node[\"Telegram Trigger\"].json[\"message\"][\"chat\"][\"id\"] }}",
                "file": "={{ $json[\"stdout\"].trim() }}",
                "caption": "Готово! Видео без вотермарки (через n8n)",
                "additionalFields": {}
            },
            "id": "f1e2d3c4-b5a6-4c7d-8e9f-0a1b2c3d4e5f",
            "name": "Send Video",
            "type": "n8n-nodes-base.telegram",
            "typeVersion": 1,
            "position": [
                750,
                300
            ],
            "credentials": {
                "telegramApi": {
                    "id": "YOUR_CREDENTIAL_ID",
                    "name": "Telegram Bot"
                }
            }
        }
    ],
    "connections": {
        "Telegram Trigger": {
            "main": [
                [
                    {
                        "node": "Execute Remover",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Execute Remover": {
            "main": [
                [
                    {
                        "node": "Send Video",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}