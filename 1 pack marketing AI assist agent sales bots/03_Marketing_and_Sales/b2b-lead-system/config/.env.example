# ═══════════════════════════════════════════════
#   B2B Lead System — Переменные окружения
#   Скопируй в .env и заполни своими данными
# ═══════════════════════════════════════════════

# ─── Supabase ───────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# ─── OpenAI ─────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Telegram Bot ───────────────────────────
# Создать бота: @BotFather → /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCDEFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID чата куда слать алерты (свой личный или канал)
# Узнать ID: @userinfobot или @getmyid_bot
TELEGRAM_ALERT_CHAT_ID=-100123456789

# ─── WhatsApp (Meta Cloud API) ──────────────
# https://developers.facebook.com → My Apps → WhatsApp
WHATSAPP_API_TOKEN=EAA...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_random_string

# ─── 2ГИС API ───────────────────────────────
# Получить: https://dev.2gis.ru/
GIS_API_KEY=your_2gis_api_key

# ─── Google Places API ──────────────────────
# Получить: https://console.cloud.google.com → Maps → Places API
GOOGLE_PLACES_API_KEY=AIza...

# ─── Настройки парсера ──────────────────────
PARSER_DEFAULT_CITY=Алматы
PARSER_DEFAULT_SPHERE=IT
PARSER_DEFAULT_ROLE=директор
PARSER_HH_PAGES=5
PARSER_ADATA_PAGES=3

# ─── Настройки анализатора ──────────────────
RELEVANCE_THRESHOLD=0.65
CHECK_INTERVAL_MINUTES=30
MIN_MESSAGE_LENGTH=15
AI_MODEL=gpt-4o
