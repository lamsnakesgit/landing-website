        "jsCode": "const input = $input.first().json;\nconst raw = input.output || input.text || '{}';\nlet parsed;\ntry { parsed = JSON.parse(String(raw).replace(/```json|```/g, '').trim()); } catch (e) { parsed = { meeting_title: 'Untitled', one_paragraph_summary: String(raw), key_topics: [], decisions: [], action_items: [], next_steps: [], open_questions: [], timeline: [], confidence_notes: ['JSON parse fallback used'] }; }\nreturn [{ json: { ...$('Merge Canonical Text').first().json, structurer: parsed } }];"
      },
