      "parameters": {
        "jsCode": "const meta = $('Detect Input Type').first().json;\nconst item = $input.first();\nif (!item.binary || !item.binary.data) throw new Error('Binary file not found');\nitem.binary.data.fileName = meta.file_name || item.binary.data.fileName || `input.${meta.file_ext || 'bin'}`;\nitem.binary.data.mimeType = meta.mime_type || item.binary.data.mimeType || 'application/octet-stream';\nreturn [{ json: { ...meta, media_ready: true }, binary: { data: item.binary.data } }];"
      },
