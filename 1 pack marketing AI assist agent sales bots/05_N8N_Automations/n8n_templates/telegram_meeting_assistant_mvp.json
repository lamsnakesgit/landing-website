    {
      "parameters": {
        "jsCode": "const msg = $json.message || {};\nconst file = msg.voice || msg.audio || msg.document || msg.video || msg.video_note || null;\nconst fileName = file?.file_name || msg.document?.file_name || null;\nconst mimeType = file?.mime_type || null;\nconst ext = fileName && fileName.includes('.') ? fileName.split('.').pop().toLowerCase() : null;\n\nlet inputType = 'unknown';\nif (msg.text) inputType = 'text';\nelse if (msg.voice) inputType = 'voice';\nelse if (msg.audio) inputType = 'audio';\nelse if (msg.document) {\n  const audioExts = ['m4a', 'mp3', 'wav', 'aac', 'ogg'];\n  inputType = audioExts.includes(ext || '') ? 'document_audio' : 'document_other';\n} else if (msg.video_note) inputType = 'video_note';\nelse if (msg.video) inputType = 'video';\n\nreturn [{ json: {\n  chat_id: msg.chat?.id,\n  message_id: msg.message_id,\n  user_id: msg.from?.id,\n  username: msg.from?.username || '',\n  first_name: msg.from?.first_name || '',\n  input_type: inputType,\n  text_input: msg.text || msg.caption || '',\n  file_id: file?.file_id || null,\n  file_name: fileName,\n  mime_type: mimeType,\n  file_ext: ext,\n  raw_message: msg\n}}];"
      },
