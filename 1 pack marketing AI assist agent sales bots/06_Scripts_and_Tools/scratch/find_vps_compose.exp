#!/usr/bin/expect -f

set timeout 30
set password "r0oLNJP3xCO7O4SnL0bj"
set ip "151.241.100.226"
set user "root"

puts "=== ПОИСК DOCKER-COMPOSE НА VPS ==="

spawn ssh -o StrictHostKeyChecking=no $user@$ip "find /root -name \"docker-compose.yml\" -o -name \"*.env\" 2>/dev/null"
expect {
    "assword:" {
        send "$password\r"
        exp_continue
    }
    eof
}
