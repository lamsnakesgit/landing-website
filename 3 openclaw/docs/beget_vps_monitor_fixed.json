        {
            "parameters": {
                "jsCode": "// Получаем все регионы\nconst regions = $input.item.json.regions;\n\n// Фильтруем только Казахстан и Латвию\nconst targetRegions = regions.filter(region => \n  region.country === 'KZ' || region.country === 'LV'\n);\n\n// Возвращаем только ДОСТУПНЫЕ серверы\nconst availableRegions = targetRegions.filter(region => region.available === true);\n\n// Если нет доступных - возвращаем пустой массив\nif (availableRegions.length === 0) {\n  return [];\n}\n\n// Возвращаем каждый регион как отдельный item\nreturn availableRegions.map(region => ({\n  json: {\n    id: region.id,\n    name: region.name,\n    country: region.country,\n    available: region.available\n  }\n}));"
            },
