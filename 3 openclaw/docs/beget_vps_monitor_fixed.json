        {
            "parameters": {
                "jsCode": "// Новый узел Code после Telegram для подготовки данных\n// Получаем регионы из узла \"Проверка - отправляли сегодня?\" а не из Telegram!\n// Защита от пустого ответа \nconst checkNode = $('Проверка - отправляли сегодня?').item;\nif (!checkNode || !checkNode.json || !checkNode.json.regions) {\n  return [];\n}\n\nconst regions = checkNode.json.regions;\nconst tableData = $('Получить даты отправки').all();\n\nreturn regions.map(region => {\n  const existingRecord = tableData.find(item => item && item.json && item.json.country === region.country);\n  \n  return {\n    json: {\n      country: region.country,\n      recordId: existingRecord ? existingRecord.json.id : null,\n      action: existingRecord ? 'update' : 'insert'\n    }\n  };\n});"
            },
