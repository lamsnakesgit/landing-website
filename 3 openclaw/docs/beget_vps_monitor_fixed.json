            "name": "Получить даты отправки",
            "alwaysOutputData": true,
            "executeOnce": true
        },
        {
            "parameters": {
                "jsCode": "// Получаем ВСЕ регионы из фильтра\nconst regions = $('Фильтр KZ и LV').all().map(item => item.json);\n\n// Получаем записи из таблицы\nconst tableData = $('Получить даты отправки').all();\n\n// Текущая дата\nconst today = new Date().toISOString().split('T')[0];\n\n// Фильтруем регионы, для которых НЕ отправляли сегодня\nconst regionsToNotify = regions.filter(region => {\n  // Находим запись в таблице для этого региона (с защитой от пустого alwaysOutputData)\n  const countryRecord = tableData.find(item => item && item.json && item.json.country === region.country);\n  \n  // Если записи нет или дата не сегодня - добавляем в список\n  return !countryRecord || countryRecord.json.last_sent_date !== today;\n});\n\n// Если есть регионы для уведомления\nif (regionsToNotify.length > 0) {\n  return [{\n    json: {\n      regions: regionsToNotify,\n      shouldSend: true\n    }\n  }];\n}\n\n// Ничего не отправляем\nreturn [];"
            },
